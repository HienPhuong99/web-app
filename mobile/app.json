{
  "expo": {
    "name": "phuonghihi",
    "slug": "phuonghihi",
    "version": "1.0.0",
    "scheme": "phuonghihi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phuonghihi.banhang"
    },
    "android": {
      "package": "com.phuonghihi.banhang",
      "adaptiveIcon": {
        "backgroundColor": "#FFF1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng dùng camera để quét mã vạch IMEI/serial trên hộp máy.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng mở ảnh bạn chọn để đọc mã vạch / mã QR IMEI trong ảnh.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ứng dụng dùng Face ID để khóa app bán hàng, tránh người khác mở khi cầm máy."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B4A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://script.google.com/macros/s/AKfycbx66egogcD-sQxv48gLIjCJqeIIEeD_jwkIdmSYAKRsrHKjF_2hV1SMfa-yHRMTt02Z/exec",
      "eas": {
        "projectId": "cdee3625-77cb-42a9-a5e5-318d0dbc1dc4"
      }
    },
    "owner": "hienphuong"
  }
}
